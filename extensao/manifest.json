{
  "manifest_version": 3,
  "name": "Arquivo Seguro: alerta de anexo disfarçado",
  "short_name": "Arquivo Seguro",
  "version": "1.1.1",
  "description": "Avisa quando um anexo ou download finge ser PDF, mas é um script ou programa. Roda no seu computador, sem enviar dados.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icones/icone16.png",
    "32": "icones/icone32.png",
    "48": "icones/icone48.png",
    "128": "icones/icone128.png"
  },
  "action": {
    "default_title": "Arquivo Seguro",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "fundo.js"
  },
  "permissions": ["downloads", "storage", "scripting"],
  "optional_host_permissions": ["*://*/*"],
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*",
        "https://mail.yahoo.com/*",
        "https://mail.proton.me/*",
        "https://mail.zoho.com/*",
        "https://web.whatsapp.com/*"
      ],
      "js": ["regras.js", "conteudo.js"],
      "run_at": "document_idle"
    }
  ]
}
